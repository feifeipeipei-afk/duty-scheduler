# 值日排班管理系统环境配置示例
# 复制为 .env 并修改后使用（docker-compose 会自动读取同目录 .env）

# 后台管理密码（务必修改默认值）
ADMIN_PASSWORD=change-me

# 会话签名密钥：固定后重启不掉登录；多副本部署必须一致
# 生成方式：python -c "import os; print(os.urandom(24).hex())"
FLASK_SECRET_KEY=change-me

# 调试模式（生产保持 0）
FLASK_DEBUG=0

# SQLite 数据库路径（默认为项目目录下 duty_scheduler.db）
# DUTY_SCHEDULER_DB=/data/duty_scheduler.db

# 监听端口（默认 5001）
# PORT=5001
